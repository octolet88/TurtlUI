// ==UserScript==
// @name        TurtlUI
// @description A lightweight, focused UI mod for hordes.io
// @namespace   https://hordes.io/
// @match       https://hordes.io/play
// @run-at      document-start
// @icon        https://www.google.com/s2/favicons?sz=64&domain=hordes.io
// @version     1.0.2
// @author      you
// @grant       none
// ==/UserScript==
/* TurtlUI - Version 1.0.2 */
'use strict';

(function () {

    // ============================================================
    // CONFIG + CHANGELOG
    // ============================================================
    const CONFIG = {
        appName: "TurtlUI",
        version: "1.0.2",
        storageKey: "turtluiStorage",
        turtleIcon: "/data/items/pet/pet15_q3.avif" // Bubbles pet icon, hosted on hordes.io itself
    };

    // Keep this updated every release - it's shown in the in-game menu
    // and can be copy/pasted straight into Discord.
    const CHANGELOG = [
        {
            version: "1.0.2",
            date: "2026-07-31",
            notes: [
                "Fixed Edit Mode not actually moving anything - dragging is back to a position-based system (transform was getting fought by the game's own styling).",
                "Fixed the shrinking bug properly this time: size is only frozen for the moment an element is being repositioned in Edit Mode, and fully released back to native sizing the instant Edit Mode is turned off - so party frame growth, skillbar layout, etc. are untouched outside of editing."
            ]
        },
        {
            version: "1.0.1",
            date: "2026-07-31",
            notes: [
                "Fixed player frame and party frame shrinking when Edit Mode was enabled - dragging no longer touches size, position, or width/height, only a visual offset.",
                "Player Frame and Target Frame now drag fully independently of one another.",
                "Removed the minimap from Edit Mode entirely - the map is never touched.",
                "Fixed the TurtlUI icon placement - it now sits directly inside the native system button row instead of a separate floating bar."
            ]
        },
        {
            version: "1.0.0",
            date: "2026-07-31",
            notes: [
                "Initial release of TurtlUI.",
                "Added the TurtlUI menu button next to the system button bar.",
                "Added Edit Mode: drag the skillbar, chat window, party frames, target frames, and unit frames anywhere on screen.",
                "Skillbar is now locked to a rigid 20 slots per row.",
                "Added an in-menu changelog viewer."
            ]
        }
    ];

    // ============================================================
    // TINY DOM HELPER
    // ============================================================
    class El {
        constructor(tag, opts = {}) {
            this.element = document.createElement(tag);
            Object.assign(this.element, opts);
        }
        text(t) { this.element.textContent = t; return this; }
        css(c) { this.element.className = c; return this; }
        style(s) { Object.assign(this.element.style, s); return this; }
        attr(k, v) { this.element.setAttribute(k, v); return this; }
        on(evt, fn) { this.element.addEventListener(evt, fn); return this; }
        add(child) { this.element.appendChild(child.element ? child.element : child); return this; }
        remove() { this.element.remove(); return this; }
    }
    const el = (tag, opts) => new El(tag, opts);

    function injectStyle(css) {
        const style = document.createElement("style");
        style.textContent = css;
        document.head.appendChild(style);
    }

    injectStyle(`
        .turtlui-btn { cursor: pointer; }
        .turtlui-editable {
            outline: 2px dashed #4de751 !important;
            cursor: move !important;
        }
        body.turtlui-dragging {
            user-select: none !important;
        }
        .turtlui-window {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 9999;
            width: 420px;
            max-height: 80vh;
            overflow-y: auto;
            padding: 10px;
        }
        .turtlui-window .titleframe {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .turtlui-window .title {
            font-weight: bold;
            padding: 4px;
        }
        .turtlui-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 4px;
            margin-bottom: 6px;
        }
        .turtlui-edit-toggle {
            padding: 6px 12px;
            text-align: center;
        }
        .turtlui-edit-toggle.on { color: #4de751; }
        .turtlui-edit-toggle.off { color: #9de74d80; }
        .turtlui-changelog-entry { margin-bottom: 10px; }
        .turtlui-changelog-version { font-weight: bold; }
        .turtlui-changelog-date { opacity: 0.6; font-size: 0.85em; margin-left: 6px; }
        .turtlui-changelog-notes { margin: 4px 0 0 16px; padding: 0; }
        .turtlui-changelog-notes li { margin-bottom: 2px; }
    `);

    // ============================================================
    // STORAGE (positions only - nothing fancy needed yet)
    // ============================================================
    const storage = {
        load() {
            try {
                return JSON.parse(localStorage.getItem(CONFIG.storageKey)) || {};
            } catch (e) {
                return {};
            }
        },
        save(state) {
            localStorage.setItem(CONFIG.storageKey, JSON.stringify(state));
        }
    };

    const state = Object.assign({
        editMode: false,
        positions: {} // { key: { dx, dy } } - offset from natural layout position
    }, storage.load());

    function persist() {
        storage.save(state);
    }

    // ============================================================
    // ELEMENT WAITER (polls until the selector shows up)
    // ============================================================
    function waitFor(selector, callback, root = document) {
        const found = root.querySelector(selector);
        if (found) {
            callback(found);
            return;
        }
        setTimeout(() => waitFor(selector, callback, root), 250);
    }

    // ============================================================
    // DRAGGABLE SYSTEM (only active while Edit Mode is on)
    //
    // Uses position: absolute + left/top while Edit Mode is active,
    // since that's what actually renders/drags correctly here (a plain
    // CSS transform gets fought/overwritten by the game's own styling
    // on these elements). The bug last time wasn't "absolute is wrong",
    // it was that left/top were set without width/height - per the CSS
    // spec, an absolutely positioned box with width:auto and right:auto
    // collapses to shrink-to-fit, which is exactly what shrank the
    // player frame and party frame.
    //
    // The fix: freeze width/height (and the current left/top) ONLY at
    // the moment Edit Mode is switched on, and fully clear every
    // inline style override the moment Edit Mode is switched off. That
    // way the party frame's dynamic grid, the skillbar's own layout,
    // etc. behave completely normally outside of Edit Mode - nothing is
    // ever size-locked except while you're actively repositioning it.
    // ============================================================
    function makeDraggable(target, key) {
        const saved = state.positions[key] || { dx: 0, dy: 0 };
        let dx = saved.dx;
        let dy = saved.dy;

        let baseLeft = 0, baseTop = 0;
        let dragging = false;
        let startX, startY, startLeft, startTop;

        function enter() {
            const rect = target.getBoundingClientRect();
            const offsetParent = target.offsetParent || document.body;
            const parentRect = offsetParent.getBoundingClientRect();
            baseLeft = rect.left - parentRect.left;
            baseTop = rect.top - parentRect.top;

            target.style.position = "absolute";
            target.style.width = rect.width + "px";
            target.style.height = rect.height + "px";
            target.style.left = (baseLeft + dx) + "px";
            target.style.top = (baseTop + dy) + "px";
            target.classList.add("turtlui-editable");
        }

        function exit() {
            target.style.position = "";
            target.style.width = "";
            target.style.height = "";
            target.style.left = "";
            target.style.top = "";
            target.classList.remove("turtlui-editable");
        }

        target.addEventListener("mousedown", (e) => {
            if (!state.editMode) return;
            dragging = true;
            startX = e.clientX;
            startY = e.clientY;
            startLeft = parseInt(target.style.left) || 0;
            startTop = parseInt(target.style.top) || 0;
            document.body.classList.add("turtlui-dragging");
            e.preventDefault();
        });

        document.addEventListener("mousemove", (e) => {
            if (!state.editMode || !dragging) return;
            target.style.left = (startLeft + (e.clientX - startX)) + "px";
            target.style.top = (startTop + (e.clientY - startY)) + "px";
        });

        document.addEventListener("mouseup", () => {
            if (!dragging) return;
            dragging = false;
            document.body.classList.remove("turtlui-dragging");
            dx = (parseInt(target.style.left) || 0) - baseLeft;
            dy = (parseInt(target.style.top) || 0) - baseTop;
            state.positions[key] = { dx, dy };
            persist();
        });

        target._turtluiDraggable = true;
        return { enter, exit };
    }

    // Elements we care about for v1. The minimap is intentionally left
    // out - it is never touched. More elements can be added later
    // without affecting anything else.
    const DRAG_TARGETS = [
        { key: "skillbar", selector: "#skillbar" },
        { key: "partyframes", selector: ".partyframes" },
        { key: "targetframes", selector: ".targetframes" },
        { key: "ufplayer", selector: "#ufplayer" },
        { key: "uftarget", selector: "#uftarget" },
        { key: "chat", selector: "#chat", useParent: true }
    ];

    const registeredTargets = [];

    function registerDragTargets() {
        DRAG_TARGETS.forEach(({ key, selector, useParent }) => {
            waitFor(selector, (found) => {
                const target = useParent ? found.parentNode : found;
                if (target._turtluiDraggable) return;
                const controls = makeDraggable(target, key);
                registeredTargets.push(controls);
                if (state.editMode) controls.enter();
            });
        });
    }

    function refreshEditVisuals() {
        registeredTargets.forEach(controls => {
            state.editMode ? controls.enter() : controls.exit();
        });
    }

    // ============================================================
    // RIGID 20-SLOT SKILLBAR
    // ============================================================
    function lockSkillbar() {
        waitFor("#skillbar", (skillbar) => {
            const apply = () => {
                skillbar.style.gridTemplateColumns = "repeat(20, auto)";
                skillbar.style.gridAutoFlow = "dense";
            };
            apply();

            // The game occasionally re-touches inline styles on this
            // element - reassert our layout whenever that happens.
            if (!skillbar._turtluiLocked) {
                const observer = new MutationObserver(apply);
                observer.observe(skillbar, { attributes: true, attributeFilter: ["style"] });
                skillbar._turtluiLocked = true;
            }
        });
    }

    // ============================================================
    // MENU WINDOW
    // ============================================================
    let menuWindow = null;

    function buildChangelog() {
        const container = el("div");
        CHANGELOG.forEach(entry => {
            const block = el("div").css("turtlui-changelog-entry panel-black");
            const header = el("div")
                .add(el("span").css("turtlui-changelog-version textprimary").text("v" + entry.version))
                .add(el("span").css("turtlui-changelog-date").text(entry.date));
            block.add(header);
            const list = el("ul").css("turtlui-changelog-notes");
            entry.notes.forEach(note => {
                list.add(el("li").css("textsecondary").text(note));
            });
            block.add(list);
            container.add(block);
        });
        return container;
    }

    function updateEditToggle(btn) {
        btn.element.classList.toggle("on", state.editMode);
        btn.element.classList.toggle("off", !state.editMode);
        btn.text(state.editMode ? "Edit Mode: ON (drag things around)" : "Edit Mode: OFF");
    }

    function buildMenu() {
        const win = el("div").css("window panel-black border black turtlui-window");

        const titleFrame = el("div").css("titleframe");
        titleFrame.add(el("div").css("textprimary title").text(`${CONFIG.appName} v${CONFIG.version}`));
        const closeBtn = el("img", {}).css("btn black svgicon")
            .attr("src", "/data/ui/icons/cross.svg")
            .on("click", () => toggleMenu(false));
        titleFrame.add(closeBtn);
        win.add(titleFrame);

        const editRow = el("div").css("turtlui-row panel-bright");
        const editBtn = el("div").css("btn black turtlui-edit-toggle turtlui-btn");
        updateEditToggle(editBtn);
        editBtn.on("click", () => {
            state.editMode = !state.editMode;
            updateEditToggle(editBtn);
            refreshEditVisuals();
            persist();
        });
        editRow.add(editBtn);
        win.add(editRow);

        win.add(el("div").css("textprimary").style({ marginTop: "6px", marginBottom: "4px" }).text("Changelog"));
        win.add(buildChangelog());

        return win;
    }

    function toggleMenu(force) {
        const shouldShow = force !== undefined ? force : !menuWindow;
        if (shouldShow && !menuWindow) {
            menuWindow = buildMenu();
            document.body.appendChild(menuWindow.element);
        } else if (!shouldShow && menuWindow) {
            menuWindow.remove();
            menuWindow = null;
        }
    }

    // ============================================================
    // SYSTEM BUTTON BAR HOOK
    // ============================================================
    function addSysButton() {
        waitFor(".btnbar.svelte-133q4bd", (sysbtnbar) => {
            if (sysbtnbar.querySelector(".turtlui-sysbtn")) return;

            // Append straight into the real row (same row as inventory,
            // char, pvp, clan, etc.) instead of a separate floating bar,
            // so it behaves and sizes exactly like its neighbors.
            const btn = el("div").css("btn border black turtlui-sysbtn turtlui-btn");
            const icon = el("img", {}).attr("src", CONFIG.turtleIcon)
                .style({ height: "1.2em", width: "1.2em", display: "block" });
            btn.add(icon);
            btn.on("click", () => toggleMenu());

            sysbtnbar.appendChild(btn.element);
        });
    }

    // ============================================================
    // BOOTSTRAP
    // ============================================================
    function init() {
        waitFor("#ufplayer", () => {
            addSysButton();
            registerDragTargets();
            lockSkillbar();
        });
    }

    init();

})();
